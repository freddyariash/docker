# Copia este archivo a .env y pon tus credenciales reales.
# El archivo .env NO se versiona (esta en .gitignore).

# --- Conexion de la app ---
# MYSQL_HOST vacio = se autodetecta (gateway de WSL).
MYSQL_HOST=
MYSQL_PORT=3307
MYSQL_USER=appuser
MYSQL_PASSWORD=cambia-esto
MYSQL_DATABASE=appdb

# --- Solo para docker compose (contenedor MySQL) ---
MYSQL_ROOT_PASSWORD=cambia-esto-tambien
